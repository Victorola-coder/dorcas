<?xml version="1.0" encoding="utf-8"?>
<!-- Vertical layout, everything centred, with 16dp padding around the edges -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="16dp">

    <!-- The text the buttons will change -->
    <TextView
        android:id="@+id/tvGreeting"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Hello, SE Student!"
        android:textSize="24sp"
        android:layout_marginBottom="20dp" />

    <!-- Challenge 1 & 2: renamed to "Greet Me", shows a personal greeting on click -->
    <Button
        android:id="@+id/btnGreet"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Greet Me"
        android:layout_marginBottom="12dp" />

    <!-- Challenge 3: turns the greeting text blue -->
    <Button
        android:id="@+id/btnColor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Make It Blue"
        android:layout_marginBottom="24dp" />

    <!-- Lab 2 challenge 1: user types a message to send to SecondActivity -->
    <EditText
        android:id="@+id/etMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Type a message to send"
        android:inputType="text"
        android:layout_marginBottom="12dp" />

    <!-- Lab 2: opens SecondActivity, passing the message via an Intent -->
    <Button
        android:id="@+id/btnOpenSecond"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Open Second Screen" />

</LinearLayout>
